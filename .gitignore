# Python caches and local tooling
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/

# JCS manuscript build intermediates; checked release PDFs are stored in output/pdf.
paper/jcs_submission/build/
paper/jcs_submission/figures/*.png

# Editor and operating-system files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Transient experiment runtime files. Curated result artifacts are versioned.
results/**/checkpoints/
results/**/tensorboard/
*.tmp
*.lock

# Downloaded public benchmark datasets are reproducible by provenance, not committed binaries.
external_data/
external_data_*

# Third-party source snapshots (read-only audit targets). Only external/snapshots.json
# (the fingerprint) is versioned; the sources themselves are re-downloadable.
external/*
!external/snapshots.json
